<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- ============================================================
       需求 1：给通用基因编译器加「内置营养池 + 自动搬运补料」
       ============================================================
       用原版 CompRefuelable 当营养池：
         * 燃料条 / 检查面板 / 补料阈值 / 搬运补料全部沿用原版逻辑；
         * consumeFuelOnlyWhenUsed=true 让它自己不再消耗，改由
           Comp_UGCNutritionFeeder 按舱内人员的饱食度缺口扣营养；
         * 挂上 CompRefuelable 后该建筑自动进入 ThingRequestGroup.Refuelable，
           原版 WorkGiver_Refuel 会派小人搬食物来补料（等同培育仓）。
       食物过滤条件照抄原版培育仓 GrowthVat 的设置。

       另外这里还挂了本补丁自己的三个 comp：
         * Comp_UGCNutritionFeeder —— 需求 1 的「用营养换饱食度」；
         * Comp_UGCAutoExtraction —— 需求 2 的「冷却结束自动入舱」；
         * Comp_UGCExtractionTimer —— 需求 7 的「提取作业计时器」。
       ============================================================ -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="UniversalGeneCompiler"]/comps</xpath>
    <value>

      <li Class="CompProperties_Refuelable">
        <compClass>CompRefuelable</compClass>
        <!-- 营养池容量（沿用原版「一件食物 = 1 点」的计数方式，10 点约等于 10 份食物） -->
        <fuelCapacity>10</fuelCapacity>
        <!-- 自己不做任何 tick 消耗，全部由 Comp_UGCNutritionFeeder 手动扣 -->
        <fuelConsumptionRate>0</fuelConsumptionRate>
        <initialFuelPercent>0</initialFuelPercent>
        <!-- 低于 25% 就让小人来补料 -->
        <autoRefuelPercent>0.25</autoRefuelPercent>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <showFuelGizmo>false</showFuelGizmo>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <!-- 空池时不画「缺燃料」红色覆盖图标（本补丁自己会在面板提示） -->
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <!-- [MustTranslate]：中文翻译见 DefInjected/ThingDef/UniversalGeneCompiler.xml -->
        <fuelLabel>Nutrition</fuelLabel>
        <fuelFilter>
          <categories>
            <li>Foods</li>
          </categories>
          <specialFiltersToDisallow>
            <li>AllowPlantFood</li>
          </specialFiltersToDisallow>
          <disallowedCategories>
            <li>EggsFertilized</li>
          </disallowedCategories>
          <disallowedThingDefs>
            <li>InsectJelly</li>
            <li>MealLavish</li>
            <li>MealLavish_Veg</li>
            <li>MealLavish_Meat</li>
            <li>HemogenPack</li>
            <li>Chocolate</li>
          </disallowedThingDefs>
        </fuelFilter>
      </li>

      <li Class="GeneCompilerPatch.CompProperties_UGCNutritionFeeder">
        <!--
          补满 1 点饱食度需要消耗多少点营养。
          1 点营养约等于 1 份食物（CompRefuelable 按「件数」计数），而殖民者正常进食
          大约是每天 1 份，所以 3 表示「按培育仓的消耗速度喂」（原版 GrowthVat
          对一个正在培育的个体是每天 3 营养）。想便宜点就改成 1。
        -->
        <nutritionPerFoodLevel>3</nutritionPerFoodLevel>
        <checkIntervalTicks>250</checkIntervalTicks>
      </li>

      <li Class="GeneCompilerPatch.CompProperties_UGCAutoExtraction">
        <defaultEnabled>true</defaultEnabled>
        <checkIntervalTicks>250</checkIntervalTicks>
      </li>

      <!-- 需求 7：提取作业计时器（默认 6 小时，可在模组设置里改；设为 0 即关闭本功能） -->
      <li Class="GeneCompilerPatch.CompProperties_UGCExtractionTimer" />

    </value>
  </Operation>


  <!-- ============================================================
       需求 4：两个 StatDef 会出现在所有物品上
       ============================================================
       原模组给 UGC_GeneticComplexityCapacity / UGC_StoredGeneCapacity 设了
       showOnDefaultValue=true，且没有 showIfUndefined=false，于是任何没有
       定义这两个 stat 的 def 都会把它们显示出来（值恒为 0）。
       这里关掉 showOnDefaultValue 并补上 showIfUndefined=false。
       ============================================================ -->

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/StatDef[defName="UGC_GeneticComplexityCapacity"]/showOnDefaultValue</xpath>
    <value>
      <showOnDefaultValue>false</showOnDefaultValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/StatDef[defName="UGC_GeneticComplexityCapacity"]</xpath>
    <value>
      <showIfUndefined>false</showIfUndefined>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/StatDef[defName="UGC_StoredGeneCapacity"]/showOnDefaultValue</xpath>
    <value>
      <showOnDefaultValue>false</showOnDefaultValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/StatDef[defName="UGC_StoredGeneCapacity"]</xpath>
    <value>
      <showIfUndefined>false</showIfUndefined>
    </value>
  </Operation>


  <!-- ============================================================
       需求 5：提高「把人搬进通用基因编译器」的优先级
       ============================================================
       原值是 90，和原版 CarryToGeneExtractor / CarryToGrowthVat 平级。
       原版 Hauling 工作类型里最高的是 RearmTurrets=150、Refuel=140。
       玩家既然手动指定了要把某人送进机器，就应当先于普通搬运完成，
       所以提到 160（Hauling 内最高）。
       ============================================================ -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/WorkGiverDef[defName="UGC_CarryToUniversalGeneCompiler"]/priorityInType</xpath>
    <value>
      <priorityInType>160</priorityInType>
    </value>
  </Operation>

</Patch>
